  "cards": [
    {
      "dot": "emerald",
      "title": "一致性边界",
      "items": [
        "PostgreSQL 保存业务事实、权威向量与长期任务状态",
        "Kafka 提供可回放事件和短时唤醒，不承担长期租约",
        "Redis 只承载可重建缓存、计数与协调状态"
      ]
    },
    {
      "dot": "cyan",
      "title": "媒体边界",
      "items": [
        "MinIO / S3 Bucket 保持私有",
        "API 为浏览器签发受控媒体 URL",
        "Worker 读取原始对象并写回处理结果"
      ]
    },
    {
      "dot": "violet",
      "title": "外部模型隔离",
      "items": [
        "多模态能力默认关闭，不会自动产生付费调用",
        "DashScope API Key 只进入隔离适配器",
        "API 与 Worker 通过版本化 HMAC 合同连接适配器"
      ]
    }
  ]
