# Dedicated local acceptance accounts. Do not reuse production credentials.
FRUX_ACCEPTANCE_USER_ACCOUNT=
FRUX_ACCEPTANCE_USER_PASSWORD=
FRUX_ACCEPTANCE_ADMIN_ACCOUNT=
FRUX_ACCEPTANCE_ADMIN_PASSWORD=

# Read-only observation connection used to verify jobs, facts, projections, and vector metadata.
FRUX_ACCEPTANCE_POSTGRES_DSN=

# Existing local fixture files; these files are uploaded twice through S3 upload sessions.
FRUX_ACCEPTANCE_VIDEO_FIXTURE=
FRUX_ACCEPTANCE_COVER_FIXTURE=

# Optional bounded overrides.
FRUX_ACCEPTANCE_API_ENDPOINT=http://127.0.0.1:8080
FRUX_ACCEPTANCE_ADAPTER_ENDPOINT=http://127.0.0.1:8099
FRUX_ACCEPTANCE_WORKER_METRICS_ENDPOINT=http://127.0.0.1:9091/metrics
FRUX_ACCEPTANCE_QUERY=雨夜城市
FRUX_ACCEPTANCE_POLL_INTERVAL=500ms
FRUX_ACCEPTANCE_STAGE_TIMEOUT=2m
FRUX_ACCEPTANCE_HTTP_TIMEOUT=20s
FRUX_ACCEPTANCE_MAX_RESPONSE_BYTES=2097152

# Keep false for validation-only runs. Billable execution also requires --execute.
FRUX_ACCEPTANCE_ALLOW_BILLABLE=false
