## Copy to .env.prod on the deployment host.
FRUX_DOMAIN=
FRUX_PUBLIC_HTTPS_PORT=
FRUX_S3_DOMAIN=

FRUX_JWT_CONSUMER_SECRET=
FRUX_JWT_ADMIN_SECRET=
# Optional during the bounded migration from the former shared JWT secret.
FRUX_JWT_LEGACY_SECRET=
FRUX_JWT_LEGACY_ISSUED_UNTIL=
FRUX_JWT_LEGACY_ACCEPT_UNTIL=
FRUX_HMAC_SECRET=
FRUX_INTERNAL_TOKEN=

# Optional until multimodal inference is explicitly enabled.
FRUX_MULTIMODAL_PROFILE=tongyi-embedding-vision-flash-2026-03-06
FRUX_MULTIMODAL_ENDPOINT=
FRUX_MULTIMODAL_HMAC_SECRET=

# Required only by the optional Tongyi multimodal-provider process.
FRUX_MULTIMODAL_PROVIDER_LISTEN_ADDR=127.0.0.1:8099
DASHSCOPE_API_KEY=
FRUX_TONGYI_UPSTREAM_TIMEOUT=20s
FRUX_TONGYI_MAX_REQUEST_BYTES=25165824
FRUX_TONGYI_MAX_RESPONSE_BYTES=2097152
FRUX_TONGYI_SHUTDOWN_TIMEOUT=10s

FRUX_POSTGRES_USER=frux
FRUX_POSTGRES_PASSWORD=
FRUX_POSTGRES_DATABASE=frux

FRUX_REDIS_PASSWORD=

FRUX_MINIO_ROOT_USER=
FRUX_MINIO_ROOT_PASSWORD=
FRUX_MINIO_API_PORT=19000
FRUX_MINIO_CONSOLE_PORT=19001

FRUX_S3_ACCESS_KEY=
FRUX_S3_SECRET_KEY=
FRUX_S3_BUCKET=frux-media

FRUX_BACKUP_INTERVAL_SECONDS=86400
FRUX_BACKUP_RETENTION_DAYS=14

FRUX_WEB_PORT=18080
FRUX_API_PORT=18081
