# Optional until multimodal inference is explicitly enabled.
FRUX_MULTIMODAL_ENDPOINT=
FRUX_MULTIMODAL_HMAC_SECRET=

FRUX_POSTGRES_USER=frux
FRUX_POSTGRES_PASSWORD=
FRUX_POSTGRES_DATABASE=frux

FRUX_REDIS_PASSWORD=

FRUX_MINIO_ROOT_USER=
FRUX_MINIO_ROOT_PASSWORD=
