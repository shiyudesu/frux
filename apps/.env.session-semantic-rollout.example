# Copy to apps/.env.session-semantic-rollout. This file is discovered automatically.
# The command also loads FRUX_MULTIMODAL_PROFILE from apps/.env.multimodal.

FRUX_SESSION_SEMANTIC_ROLLOUT_POSTGRES_DSN=postgres://frux:password@127.0.0.1:5432/frux?sslmode=disable
FRUX_SESSION_SEMANTIC_ROLLOUT_API_METRICS_ENDPOINT=http://127.0.0.1:8080/metrics
FRUX_SESSION_SEMANTIC_ROLLOUT_SHADOW_REPORT=/tmp/session-semantic-shadow-report.json
FRUX_SESSION_SEMANTIC_ROLLOUT_SOURCE_VERSION=2
FRUX_SESSION_SEMANTIC_ROLLOUT_TARGET_VERSION=3
FRUX_SESSION_SEMANTIC_ROLLOUT_PERCENTAGE=1
FRUX_SESSION_SEMANTIC_ROLLOUT_REPORT=/tmp/session-semantic-rollout-report.json
FRUX_SESSION_SEMANTIC_ROLLOUT_HTTP_TIMEOUT=3s
FRUX_SESSION_SEMANTIC_ROLLOUT_MAX_RESPONSE_BYTES=2097152

# Keep false for plan/status. Mutations also require --execute.
FRUX_SESSION_SEMANTIC_ROLLOUT_ALLOW_MUTATION=false
