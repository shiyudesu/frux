# Copy this file to apps/.env.multimodal. Native Frux commands discover it automatically.
# Existing process environment variables take precedence over values in this file.

# Frux-facing adapter endpoint. Keep this on loopback when using plaintext HTTP.
FRUX_MULTIMODAL_PROVIDER_LISTEN_ADDR=127.0.0.1:8099
FRUX_MULTIMODAL_ENDPOINT=http://127.0.0.1:8099

# Set the same value for API, Worker, and adapter. Supported values:
# - tongyi-embedding-vision-flash-2026-03-06 (native fused vector, recommended)
# - tongyi-embedding-vision-flash (independent vectors with deterministic local mean fusion)
FRUX_MULTIMODAL_PROFILE=tongyi-embedding-vision-flash-2026-03-06

# Generate one value and share it only between the Frux API/Worker and adapter.
FRUX_MULTIMODAL_HMAC_SECRET=

# Use the exact native multimodal-embedding endpoint for your Alibaba Cloud region/workspace.
DASHSCOPE_MULTIMODAL_ENDPOINT=
DASHSCOPE_API_KEY=

# Optional bounded overrides.
FRUX_TONGYI_UPSTREAM_TIMEOUT=20s
FRUX_TONGYI_MAX_REQUEST_BYTES=25165824
FRUX_TONGYI_MAX_RESPONSE_BYTES=2097152
FRUX_TONGYI_SHUTDOWN_TIMEOUT=10s
