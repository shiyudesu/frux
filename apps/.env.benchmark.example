# Copy to /opt/frux-benchmark/.env.benchmark. The install script generates
# secrets automatically when this file does not yet exist.

FRUX_BENCH_POSTGRES_USER=frux_bench
FRUX_BENCH_POSTGRES_PASSWORD=
FRUX_BENCH_POSTGRES_DATABASE=frux_benchmark
FRUX_BENCH_REDIS_PASSWORD=
FRUX_BENCH_FEED_CACHE_MODE=batch
FRUX_BENCH_JWT_CONSUMER_SECRET=
FRUX_BENCH_JWT_ADMIN_SECRET=
FRUX_BENCH_HMAC_SECRET=
FRUX_BENCH_INTERNAL_TOKEN=
FRUX_BENCH_VIEWER_PASSWORD=

# Bound to loopback. Use an SSH tunnel if interactive access is needed; the
# k6 container talks to the API over the private Compose network.
FRUX_BENCH_API_PORT=28081
FRUX_BENCH_PROMETHEUS_PORT=29090

# Resource caps protect the existing frux-prod stack on an 8-core/24-GiB host.
# Raise them only during a scheduled test window and record the effective caps
# in benchmark results.
FRUX_BENCH_POSTGRES_CPUS=0.75
FRUX_BENCH_POSTGRES_MEMORY=2g
FRUX_BENCH_REDIS_CPUS=0.25
FRUX_BENCH_REDIS_MEMORY=1g
FRUX_BENCH_REDIS_MAXMEMORY=768mb
FRUX_BENCH_KAFKA_CPUS=0.75
FRUX_BENCH_KAFKA_MEMORY=2g
FRUX_BENCH_KAFKA_HEAP_OPTS=-Xms512m -Xmx1024m
FRUX_BENCH_API_CPUS=1.5
FRUX_BENCH_API_MEMORY=3g
FRUX_BENCH_WORKER_CPUS=1
FRUX_BENCH_WORKER_MEMORY=2g
FRUX_BENCH_PROMETHEUS_CPUS=0.25
FRUX_BENCH_PROMETHEUS_MEMORY=768m
FRUX_BENCH_K6_CPUS=1
FRUX_BENCH_K6_MEMORY=1g
FRUX_BENCH_SEED_CPUS=1
FRUX_BENCH_SEED_MEMORY=1g

# Keep Kafka and Prometheus disk use bounded on the 50-GiB server.
FRUX_BENCH_KAFKA_RETENTION_HOURS=2
FRUX_BENCH_KAFKA_RETENTION_BYTES=134217728
FRUX_BENCH_KAFKA_SEGMENT_BYTES=67108864
FRUX_BENCH_PROMETHEUS_RETENTION=48h
FRUX_BENCH_PROMETHEUS_SIZE=512MB

# Reproducible synthetic workload. The seed is idempotent; changing counts on
# an existing volume only adds missing rows. Destroy the isolated benchmark
# volumes before reseeding a smaller dataset.
FRUX_BENCH_SEED_USERS=12000
FRUX_BENCH_SEED_AUTHORS=500
FRUX_BENCH_SEED_VIDEOS=50000
FRUX_BENCH_SEED_FOLLOWS_PER_USER=30

FRUX_BENCH_K6_IMAGE=grafana/k6:2.2.0
FRUX_BENCH_RESULTS_DIR=./benchmark-results
FRUX_BENCH_SCENE=timeline
FRUX_BENCH_VUS=20
FRUX_BENCH_DURATION=60s
FRUX_BENCH_LIMIT=20
FRUX_BENCH_THINK_TIME=0
