# Copy to apps/.env.session-semantic-acceptance. This file is discovered automatically.
# Use a dedicated local acceptance account; immutable view facts remain under that account.

FRUX_SESSION_SEMANTIC_ACCEPTANCE_API_ENDPOINT=http://127.0.0.1:8080
FRUX_SESSION_SEMANTIC_ACCEPTANCE_API_METRICS_ENDPOINT=http://127.0.0.1:8080/metrics
# Optional. When present, adapter startup/video/query operation counters must not change.
FRUX_SESSION_SEMANTIC_ACCEPTANCE_ADAPTER_METRICS_ENDPOINT=

FRUX_SESSION_SEMANTIC_ACCEPTANCE_POSTGRES_DSN=postgres://frux:password@127.0.0.1:5432/frux?sslmode=disable
FRUX_SESSION_SEMANTIC_ACCEPTANCE_USER_ACCOUNT=
FRUX_SESSION_SEMANTIC_ACCEPTANCE_USER_PASSWORD=

# Three distinct, currently readable videos with current Fact + Projection under FRUX_MULTIMODAL_PROFILE.
FRUX_SESSION_SEMANTIC_ACCEPTANCE_POSITIVE_VIDEO_ID=
FRUX_SESSION_SEMANTIC_ACCEPTANCE_NEGATIVE_VIDEO_ID=
FRUX_SESSION_SEMANTIC_ACCEPTANCE_TARGET_VIDEO_ID=

FRUX_SESSION_SEMANTIC_ACCEPTANCE_POLL_INTERVAL=250ms
FRUX_SESSION_SEMANTIC_ACCEPTANCE_STAGE_TIMEOUT=30s
FRUX_SESSION_SEMANTIC_ACCEPTANCE_HTTP_TIMEOUT=20s
FRUX_SESSION_SEMANTIC_ACCEPTANCE_MAX_RESPONSE_BYTES=2097152

# Required together with --execute. This is a mutation acknowledgement, not a billing gate.
FRUX_SESSION_SEMANTIC_ACCEPTANCE_ALLOW_MUTATION=false
